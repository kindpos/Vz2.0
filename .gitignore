# Python bytecode for the version of Python actually running (the repo
# historically tracks .cpython-312.pyc files; 311 artifacts are build
# artifacts that should stay local).
*.cpython-311*.pyc
*.cpython-313*.pyc

# Test-run scratch databases created by conftest fixtures.
backend/data/test_*.db
backend/data/test_*.db-shm
backend/data/test_*.db-wal
data/test_*.db
data/test_*.db-shm
data/test_*.db-wal

# Runtime event ledger — recreated on app/test startup. Previously
# tracked but every test run mutated the blob, producing no-op diffs.
backend/data/event_ledger.db
backend/data/event_ledger.db-shm
backend/data/event_ledger.db-wal
data/event_ledger.db
data/event_ledger.db-shm
data/event_ledger.db-wal

# Runtime diagnostic ledger (Entomology) — recreated on boot via
# DiagnosticCollector; pure runtime state, not source.
backend/data/diagnostic_boot.db
backend/data/diagnostic_boot.db-shm
backend/data/diagnostic_boot.db-wal
data/diagnostic_boot.db
data/diagnostic_boot.db-shm
data/diagnostic_boot.db-wal

# Bombard stress-test outputs — regenerated each run.
backend/data/bombard_ledger.db
backend/data/bombard_ledger.db-shm
backend/data/bombard_ledger.db-wal
backend/data/bombard_diagnostic.db
backend/data/bombard_diagnostic.db-shm
backend/data/bombard_diagnostic.db-wal
backend/data/bombard_report.txt
backend/data/bombard_results.json
backend/data/KINDpos_Bombard_entomology_*.html

# Runtime ephemeral/print-queue DBs — pure in-process state.
backend/data/ephemeral_log.db
backend/data/ephemeral_log.db-shm
backend/data/ephemeral_log.db-wal
backend/data/print_queue.db
backend/data/print_queue.db-shm
backend/data/print_queue.db-wal

# pytest-cov artifacts
backend/.coverage
backend/htmlcov/

