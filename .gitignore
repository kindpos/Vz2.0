# Python bytecode for the version of Python actually running (the repo
# historically tracks .cpython-312.pyc files; 311 artifacts are build
# artifacts that should stay local).
*.cpython-311*.pyc
*.cpython-313*.pyc

# Test-run scratch databases created by conftest fixtures.
backend/data/test_*.db
backend/data/test_*.db-shm
backend/data/test_*.db-wal

# Runtime event ledger — recreated on app/test startup. Previously
# tracked but every test run mutated the blob, producing no-op diffs.
backend/data/event_ledger.db
backend/data/event_ledger.db-shm
backend/data/event_ledger.db-wal

# Runtime diagnostic ledger (Entomology) — recreated on boot via
# DiagnosticCollector; pure runtime state, not source.
backend/data/diagnostic_boot.db
backend/data/diagnostic_boot.db-shm
backend/data/diagnostic_boot.db-wal

# pytest-cov artifacts
backend/.coverage
backend/htmlcov/

# Virtualenvs & editor state
.venv/
venv/
.vscode/
.idea/

# Vitest / node
node_modules/
coverage/
