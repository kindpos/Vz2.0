# kindpos.toml — per-customer store configuration
# Generated by the image builder (PROVISIONING_FLOW.md §3.2)
# Placed at /var/lib/kindpos/kindpos.toml by first-boot.sh

[store]
store_name     = "{store_name}"
customer_email = "{customer_email}"

[support]
contact_email = "support@kindpos.com"
contact_phone = "(XXX) XXX-XXXX"
