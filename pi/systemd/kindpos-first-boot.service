[Unit]
Description=KINDpos first-boot overlay application
ConditionPathExists=/boot/kindpos-overlay.tar.gz
After=local-fs.target
Before=kindpos.service

[Service]
Type=oneshot
ExecStart=/boot/first-boot.sh
RemainAfterExit=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
