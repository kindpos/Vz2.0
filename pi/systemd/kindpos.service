[Unit]
Description=KINDpos Server
After=network.target
Wants=kindpos-first-boot.service

[Service]
User=kindpos
WorkingDirectory=/home/kindpos/Vz2.0/backend
Environment=PYTHONPATH=/home/kindpos/Vz2.0/backend
ExecStart=/home/kindpos/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
